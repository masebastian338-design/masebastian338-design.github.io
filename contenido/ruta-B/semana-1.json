    { "id": "B1-L4", "tipo": "leccion", "nivel": "A1.2", "ruta": "B", "tema": "presentaciones", "habilidad": "vocabulario", "semana": 1, "orden": 4,
      "titulo": "My family", "tituloES": "Mi familia",
      "objetivo": "Talk about your family.", "objetivoES": "Hablar de tu familia.",
      "explicacionES": "Para presentar a alguien: «**This is** my mother» (Ella es mi mamá). Los posesivos van antes del sustantivo y **no cambian** con plural: **my** (mi/mis), **your** (tu/tus), **his** (su, de él), **her** (su, de ella). Ej.: «my brothers» = mis hermanos.",
      "explicacion": "This is my…  Possessives: my, your, his, her (they never change for plural).",
      "ejemplos": [
        { "en": "This is my mother.", "es": "Ella es mi mamá." },
        { "en": "I have one brother and two sisters.", "es": "Tengo un hermano y dos hermanas." },
        { "en": "His name is Daniel.", "es": "Su nombre (de él) es Daniel." },
        { "en": "Sebastián is my boyfriend.", "es": "Sebastián es mi novio." }
      ],
      "dialogo": [
        { "quien": "A", "en": "Who is this?", "es": "¿Quién es este/esta?" },
        { "quien": "B", "en": "This is my sister. Her name is Laura.", "es": "Es mi hermana. Se llama Laura." },
        { "quien": "A", "en": "And this?", "es": "¿Y este?" },
        { "quien": "B", "en": "That's my father. He is a teacher.", "es": "Ese es mi papá. Es profesor." },
        { "quien": "A", "en": "You have a beautiful family!", "es": "¡Tienes una familia hermosa!" }
      ],
      "vocabulario": ["B-v-mother", "B-v-father", "B-v-sister", "B-v-brother", "B-v-boyfriend", "B-v-family"],
      "quiz": "B1-L4-Q", "speaking": "B1-L4-S" },

