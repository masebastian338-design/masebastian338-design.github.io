    { "id": "B1-L2", "tipo": "leccion", "nivel": "A1.1", "ruta": "B", "tema": "presentaciones", "habilidad": "gramatica", "semana": 1, "orden": 2,
      "titulo": "Where are you from?", "tituloES": "¿De dónde eres?",
      "objetivo": "Say where you are from.", "objetivoES": "Decir de dónde eres y preguntar a otros.",
      "explicacionES": "El verbo **to be** cambia según la persona: **I am**, **you are**, **he/she is**, **we are**, **they are**. Para decir tu origen: «I'm **from** Colombia» (Soy de Colombia). Para preguntar: «Where **are you** from?» — en las preguntas el verbo va antes de la persona.",
      "explicacion": "To be: I am, you are, he/she is. Say: I'm from + country. Ask: Where are you from?",
      "ejemplos": [
        { "en": "Where are you from?", "es": "¿De dónde eres?" },
        { "en": "I'm from Colombia.", "es": "Soy de Colombia." },
        { "en": "She is from Mexico.", "es": "Ella es de México." },
        { "en": "We are from Latin America.", "es": "Somos de Latinoamérica." }
      ],
      "dialogo": [
        { "quien": "A", "en": "Where are you from, Xiomara?", "es": "¿De dónde eres, Xiomara?" },
        { "quien": "B", "en": "I'm from Colombia. And you?", "es": "Soy de Colombia. ¿Y tú?" },
        { "quien": "A", "en": "I'm from Canada. My friend Tom is from England.", "es": "Soy de Canadá. Mi amigo Tom es de Inglaterra." },
        { "quien": "B", "en": "Cool! Is he here?", "es": "¡Genial! ¿Él está aquí?" },
        { "quien": "A", "en": "No, he is at home.", "es": "No, está en casa." }
      ],
      "vocabulario": ["B-v-from", "B-v-where", "B-v-country", "B-v-he-she", "B-v-and-you"],
      "quiz": "B1-L2-Q", "speaking": "B1-L2-S" },

