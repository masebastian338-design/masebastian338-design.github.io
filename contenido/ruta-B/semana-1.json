    { "id": "B1-L3", "tipo": "leccion", "nivel": "A1.1", "ruta": "B", "tema": "presentaciones", "habilidad": "vocabulario", "semana": 1, "orden": 3,
      "titulo": "Numbers and age", "tituloES": "Números y edad",
      "objetivo": "Count to 20 and say your age.", "objetivoES": "Contar hasta 20 y decir tu edad.",
      "explicacionES": "En inglés la edad se dice con **to be**, no con «tener»: «I **am** 25» o «I'm 25 **years old**» (¡no «I have 25»!). Para preguntar: «How old are you?». Números: one, two, three, four, five, six, seven, eight, nine, ten… eleven, twelve… twenty.",
      "explicacion": "Age uses to be: I'm 25 (years old). Ask: How old are you?",
      "ejemplos": [
        { "en": "How old are you?", "es": "¿Cuántos años tienes?" },
        { "en": "I'm twenty-three years old.", "es": "Tengo veintitrés años." },
        { "en": "My phone number is three, five, nine…", "es": "Mi número de teléfono es tres, cinco, nueve…" },
        { "en": "I have two sisters.", "es": "Tengo dos hermanas." }
      ],
      "dialogo": [
        { "quien": "A", "en": "How old are you?", "es": "¿Cuántos años tienes?" },
        { "quien": "B", "en": "I'm twenty-two. And you?", "es": "Tengo veintidós. ¿Y tú?" },
        { "quien": "A", "en": "I'm nineteen.", "es": "Tengo diecinueve." },
        { "quien": "B", "en": "What's your phone number?", "es": "¿Cuál es tu número de teléfono?" },
        { "quien": "A", "en": "It's five, five, five, one, two, eight.", "es": "Es cinco, cinco, cinco, uno, dos, ocho." }
      ],
      "vocabulario": ["B-v-howold", "B-v-years", "B-v-number", "B-v-twelve", "B-v-twenty"],
      "quiz": "B1-L3-Q", "speaking": "B1-L3-S" },

