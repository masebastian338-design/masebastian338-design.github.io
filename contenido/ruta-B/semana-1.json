        { "quien": "A", "en": "Nice to meet you, Xiomara.", "es": "Mucho gusto, Xiomara." },
        { "quien": "B", "en": "Nice to meet you too. How are you?", "es": "Igualmente. ¿Cómo estás?" },
        { "quien": "A", "en": "I'm good, thanks!", "es": "¡Bien, gracias!" }
      ],
      "vocabulario": ["B-v-hello", "B-v-name", "B-v-nice", "B-v-howareyou", "B-v-thanks", "B-v-goodbye"],
